<Window x:Class="Ovotan.Windows.Controls.EndPointManagement.Dialogs.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ovotan.Windows.Controls.EndPointManagement.Dialogs"
        mc:Ignorable="d"
        Style="{DynamicResource OvotanEndPointManagementDialog}"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Title="Установка соединения" >
    <Grid Height="Auto" Width="250" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ProgressBar IsIndeterminate="True" Padding="0,30,0,0" Height="20" Visibility="Visible" Foreground="Blue"/>
        <Button Content="Отмена" IsCancel="True" Grid.Row="1" HorizontalAlignment="Right"/>
    </Grid>
</Window>
