<Window x:Class="Ovotan.Windows.Controls.EndPointManagement.Dialogs.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ovotan.Windows.Controls.EndPointManagement.Dialogs"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        ToolTip="werqewrewrewrew"
        Title="Установка соединения" Height="100" Width="350">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition  Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ProgressBar IsIndeterminate="True" Margin="5,10,5,0" Height="20" Visibility="Visible" Foreground="Blue"/>
        <Button Margin="5" Content="Отмена" IsCancel="True" Grid.Row="2" HorizontalAlignment="Right"/>
    </Grid>
</Window>
