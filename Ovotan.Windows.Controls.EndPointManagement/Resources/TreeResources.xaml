
	<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:local="clr-namespace:Ovotan.Windows.Controls.EndPointManagement"
                    xmlns:settings="clr-namespace:Ovotan.Windows.Controls.EndPointManagement.Settings"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Цветовые настройки дерева обозревателя объектов конечной точки.
    -->
    <settings:TreeSettings x:Key="Ovotan.Windows.Controls.EndPointManagement.TreeSettings">
        <settings:TreeSettings.TreeArrowStaticCheckedFill>
            <SolidColorBrush Color="#FF595959"/>
        </settings:TreeSettings.TreeArrowStaticCheckedFill>
        <settings:TreeSettings.TreeArrowStaticCheckedStroke>
            <SolidColorBrush Color="#FF262626"/>
        </settings:TreeSettings.TreeArrowStaticCheckedStroke>
        <settings:TreeSettings.TreeArrowMouseOverCheckedStroke>
            <SolidColorBrush Color="#006CBE"/>
        </settings:TreeSettings.TreeArrowMouseOverCheckedStroke>
        <settings:TreeSettings.TreeArrowMouseOverCheckedFill>
            <SolidColorBrush Color="Black"/>
        </settings:TreeSettings.TreeArrowMouseOverCheckedFill>
        <settings:TreeSettings.TreeArrowMouseOverStroke>
            <SolidColorBrush Color="#006CBE"/>
        </settings:TreeSettings.TreeArrowMouseOverStroke>
        <settings:TreeSettings.TreeArrowMouseOverFill>
            <SolidColorBrush Color="White"/>
        </settings:TreeSettings.TreeArrowMouseOverFill>
        <settings:TreeSettings.TreeArrowStaticFill>
            <SolidColorBrush Color="#FFFFFFFF"/>
        </settings:TreeSettings.TreeArrowStaticFill>
        <settings:TreeSettings.TreeArrowStaticStroke>
            <SolidColorBrush Color="Black"/>
        </settings:TreeSettings.TreeArrowStaticStroke>
        <settings:TreeSettings.SelectedBackgroundColor>
            <SolidColorBrush Color="#FFC4D5FF"/>
        </settings:TreeSettings.SelectedBackgroundColor>
        <settings:TreeSettings.SelectedBackground>
            <Color>#C4D5FF</Color>
        </settings:TreeSettings.SelectedBackground>
        <settings:TreeSettings.SelectedUnfocusedColor>
            <Color>#E6E7EF</Color>
        </settings:TreeSettings.SelectedUnfocusedColor>
    </settings:TreeSettings>

    <DataTemplate x:Key="Ovotan.Windows.Controls.EndPointManagement.IconFolder">
        <Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Uniform" Height="16" Width="16">
            <Canvas Name="svg60" Width="48" Height="48">
                <Canvas.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                </Canvas.RenderTransform>
                <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Name="path56" Fill="#968770">
                    <Path.Data>
                        <PathGeometry Figures="M40 12H22l-4-4H8c-2.2 0-4 1.8-4 4v8h40v-4C44 13.8 42.2 12 40 12z" FillRule="NonZero"/>
                    </Path.Data>
                </Path>
                <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Name="path58" Fill="#DCB679">
                    <Path.Data>
                        <PathGeometry Figures="M40 12H8c-2.2 0-4 1.8-4 4v20c0 2.2 1.8 4 4 4h32c2.2 0 4-1.8 4-4V16C44 13.8 42.2 12 40 12z" FillRule="NonZero"/>
                    </Path.Data>
                </Path>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <local:TreeIconStyleSelector x:Key="Ovotan.Windows.Controls.EndPointManagement.TreeIconStyleSelector"  
            Folder ="{StaticResource Ovotan.Windows.Controls.EndPointManagement.IconFolder}"/>



    <Style x:Key="Ovotan.Windows.Controls.EndPointManagement.Tree.ExpandCollapseToggleStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="Transparent" Height="16" Padding="5,5,5,5" Width="16">
                        <Path x:Name="ExpandPath"
                              Fill="{Binding Source={StaticResource Ovotan.Windows.Controls.EndPointManagement.TreeSettings}, Path=TreeArrowStaticFill}" 
                              Stroke="{Binding Source={StaticResource Ovotan.Windows.Controls.EndPointManagement.TreeSettings}, Path=TreeArrowStaticStroke}">
                            <Path.Data>
                                <PathGeometry Figures="M0,0 L0,6 L6,0 z"/>
                            </Path.Data>
                            <Path.RenderTransform>
                                <RotateTransform Angle="135" CenterY="3" CenterX="3"/>
                            </Path.RenderTransform>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="RenderTransform" TargetName="ExpandPath">
                                <Setter.Value>
                                    <RotateTransform Angle="180" CenterY="3" CenterX="3"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Stroke" TargetName="ExpandPath" 
                                    Value="{Binding Source={StaticResource Ovotan.Windows.Controls.EndPointManagement.TreeSettings}, Path=TreeArrowStaticCheckedStroke}"/>
                            <Setter Property="Fill" TargetName="ExpandPath" 
                                    Value="{Binding Source={StaticResource Ovotan.Windows.Controls.EndPointManagement.TreeSettings}, Path=TreeArrowStaticCheckedFill}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Stroke" TargetName="ExpandPath" 
                                    Value="{Binding Source={StaticResource Ovotan.Windows.Controls.EndPointManagement.TreeSettings}, Path=TreeArrowMouseOverStroke}"/>
                            <Setter Property="Fill" TargetName="ExpandPath" 
                                    Value="{Binding Source={StaticResource Ovotan.Windows.Controls.EndPointManagement.TreeSettings}, Path= TreeArrowMouseOverFill}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Stroke" TargetName="ExpandPath" 
                                    Value="{Binding Source={StaticResource Ovotan.Windows.Controls.EndPointManagement.TreeSettings}, Path=TreeArrowMouseOverCheckedStroke}"/>
                            <Setter Property="Fill" TargetName="ExpandPath" 
                                    Value="{Binding Source={StaticResource Ovotan.Windows.Controls.EndPointManagement.TreeSettings}, Path=TreeArrowMouseOverCheckedFill}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:TreeItem}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TreeItem}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MinWidth="19" Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Bd" Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="0" Value="{Binding Source={StaticResource Ovotan.Windows.Controls.EndPointManagement.TreeSettings}, Path=SelectedBackground}"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unselected" />
                                <VisualState x:Name="SelectedInactive">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Bd" Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="0" Value="{Binding Source={StaticResource Ovotan.Windows.Controls.EndPointManagement.TreeSettings}, Path=SelectedUnfocusedColor}" />
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ExpansionStates">
                                <VisualState x:Name="Expanded">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)"
                                                 Storyboard.TargetName="ItemsHost">
                                            <DiscreteObjectKeyFrame KeyTime="0"
                                                 Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Collapsed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)"
                                                 Storyboard.TargetName="ItemsHost">
                                            <DiscreteObjectKeyFrame KeyTime="0"
                                            Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>


                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Grid.Row="0" Grid.ColumnSpan="4">

                        </Border>
                        <!--Toogle button-->
                        <ToggleButton x:Name="Expander"
                                Style="{StaticResource Ovotan.Windows.Controls.EndPointManagement.Tree.ExpandCollapseToggleStyle}"
                                ClickMode="Press"
                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>

                        <!--<TextBlock Grid.Column="1" Text="sdfdsfd"/>-->
                        <ContentControl  Margin="2,0,2,0" x:Name="PART_Header"
                                          VerticalAlignment="Center"
                                          Content="{Binding NodeIcon, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ContentTemplateSelector="{Binding Source={StaticResource Ovotan.Windows.Controls.EndPointManagement.TreeIconStyleSelector}}" 
                                          Grid.Column="1" />
                        <TextBlock FontSize="12" Padding="0,1,0,2"  Text="{Binding Path=Header, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" Grid.Column="2"/>

                        <ItemsPresenter 
                            x:Name="ItemsHost" 
                            Grid.ColumnSpan="3" 
                            Grid.Column="1"
                            Grid.Row="1" 
                            Visibility="Collapsed">
                        </ItemsPresenter>
                        <!--SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>-->
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--Toogle button-->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasItems" Value="false"/>
                                <Condition Property="IsLazyLoading" Value="false"/>
                            </MultiTrigger.Conditions>
                            <MultiTrigger.Setters>
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </MultiTrigger.Setters>
                        </MultiTrigger>
                        <!--<Trigger Property="HasItems" Value="false">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>-->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasHeader" Value="false" />
                                <Condition Property="Width" Value="Auto" />
                            </MultiTrigger.Conditions>
                            <!--<Setter TargetName="PART_Header" Property="MinWidth" Value="75" />-->
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasHeader" Value="false" />
                                <Condition Property="Height" Value="Auto" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Header" Property="MinHeight" Value="19" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>