<Window x:Class="Ovotan.Shell.RabbitMQ.Controls.Doalogs.CreateConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ovotan.Shell.RabbitMQ.Controls.Doalogs"
        mc:Ignorable="d"
        Title="Новое подключение к RabbitMQ" Height="160" Width="370">
    <Grid Margin="0,5,0,0">
        <Grid.Resources>
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Margin" Value="5,2,5,2"/>
            </Style>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Margin" Value="5,2,5,2"/>
            </Style>
            <Style TargetType="{x:Type Button}">
                <Setter Property="Margin" Value="5,2,5,5"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Название" Grid.Column="0" Grid.Row="0"/>
        <TextBox Grid.Column="1" Grid.Row="0"  Text="{Binding Name}"/>
        <TextBlock Text="Хост" Grid.Column="0" Grid.Row="1"/>
        <TextBlock Text="Порт" Grid.Column="2" Grid.Row="1"/>
        <TextBox Grid.Column="1" Grid.Row="1"  Text="{Binding Host}"/>
        <TextBox Grid.Column="3" Grid.Row="1" Width="40" Text="{Binding Path=Port}"/>

        <TextBlock Text="Логин" Grid.Column="0" Grid.Row="2"/>
        <TextBox Text="{Binding Path=Login}" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="3"/>
        <TextBlock Text="Пароль"  Grid.Column="0" Grid.Row="3"/>
        <TextBox Text="{Binding Path=Password}" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="3"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Grid.ColumnSpan="4" Background="AliceBlue" HorizontalAlignment="Right">
            <Button Click="Button_Click" Content="Add"/>
            <Button Content="Close" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

    