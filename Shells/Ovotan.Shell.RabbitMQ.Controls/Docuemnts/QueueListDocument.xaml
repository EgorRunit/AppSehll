<UserControl x:Class="Ovotan.Shell.RabbitMQ.Controls.Docuemnts.QueueListDocument"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ovotan.Shell.RabbitMQ.Controls.Docuemnts"
             xmlns:controls="clr-namespace:Ovotan.Windows.Controls.EndPointManagement;assembly=Ovotan.Windows.Controls.EndPointManagement"
             xmlns:controls1="clr-namespace:Ovotan.Windows.Controls;assembly=Ovotan.Windows.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <controls:SiteHostDocumentDataGrid x:Name="SiteHostDocumentDataGrid" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <controls:SiteHostDocumentDataGrid.ToolbarElements>
            <controls1:ViewboxButton ViewboxType="NewConnection" Command="{Binding RelativeSource={ RelativeSource AncestorType=local:QueueListDocument},Path=CreateQueueCommand}"/>
            <controls1:ViewboxButton ViewboxType="Connection"/>
        </controls:SiteHostDocumentDataGrid.ToolbarElements>
    </controls:SiteHostDocumentDataGrid>
</UserControl>
