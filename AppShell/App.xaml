<Application x:Class="AppShell.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AppShell"
             xmlns:ff="clr-namespace:Ovotan.Windows.Controls;assembly=Ovotan.Windows.Controls"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ovotan.Windows.Controls.Docking;component/Resources/CanvasButtonResourcesDictionary.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Ovotan.Windows.Controls.Docking;component/Resources/DockPanelResourcesDictionary.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Ovotan.Windows.Controls.Docking;component/Resources/DockHositngSettingsResources.xaml"/>

                <ResourceDictionary Source="pack://application:,,,/Ovotan.Windows.Controls.EndPointManagement;component/Resources/Management.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Ovotan.Windows.Controls.EndPointManagement;component/Resources/TreeResources.xaml"/>

                <ff:SchemaManager DefaultSchemaName="Blue"/>

                <ResourceDictionary Source="pack://application:,,,/Ovotan.Shell.RabbitMQ.Controls;component/Resources/RabbitMQEndPointResource.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
